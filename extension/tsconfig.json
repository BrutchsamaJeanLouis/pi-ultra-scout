{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "bun"],
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": ["node_modules/@earendil-works/pi-coding-agent"],
      "@earendil-works/pi-tui": ["node_modules/@earendil-works/pi-tui"],
      "@earendil-works/pi-ai": ["node_modules/@earendil-works/pi-ai"],
      "@earendil-works/pi-agent-core": ["node_modules/@earendil-works/pi-agent-core"],
      "typebox": ["node_modules/typebox"]
    }
  },
  "include": [
    "ultrawork.ts",
    "ultrawork/**/*.ts",
    "ulw-analysis/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "*.test.ts",
    "*.spec.ts"
  ]
}