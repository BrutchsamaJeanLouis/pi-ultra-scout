{
  "name": "pi-ultra-scout",
  "version": "1.0.0",
  "description": "Ultrawork web-nudge system for pi: deterministic trust-shape detector + sequential research_dispatch tool that spawns a fresh same-weight librarian to browse live docs and return compact evidence artifacts. Protects weak local models from confidently hallucinating API defaults.",
  "main": "extension/ultrawork.ts",
  "types": "extension/ultrawork.ts",
  "scripts": {
    "build": "tsc --noEmit --strict --noUnusedLocals --noUnusedParameters --moduleResolution bundler extension/ultrawork.ts",
    "test:shapes": "cd extension && bun test ./ulw-analysis/probe_shapes.ts",
    "test:dispatch": "cd extension && bun test ./ulw-analysis/smoke_dispatch.ts",
    "test:wiring": "cd extension && bun test ./ulw-analysis/smoke_wiring.ts",
    "test:evidence": "cd extension && bun test ./ulw-analysis/probe_evidence.ts",
    "test:all": "npm run test:shapes && npm run test:dispatch && npm run test:wiring && npm run test:evidence",
    "lint": "tsc --noEmit --strict extension/ultrawork.ts",
    "prepublishOnly": "npm run build && npm run test:all",
    "pi:package": "echo 'Pi package manifest validated'"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "research-dispatch",
    "trust-shapes",
    "evidence-verification",
    "web-nudge",
    "local-llm",
    "llama.cpp"
  ],
  "author": "Brutchsama Jean-Louis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brutc/pi-ultra-scout.git"
  },
  "bugs": {
    "url": "https://github.com/brutc/pi-ultra-scout/issues"
  },
  "homepage": "https://github.com/brutc/pi-ultra-scout#readme",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.1.0",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0"
  },
  "pi": {
    "extensions": [
      "extension/ultrawork.ts"
    ],
    "video": "https://github.com/brutc/pi-ultra-scout/raw/main/docs/demo.mp4",
    "image": "https://github.com/brutc/pi-ultra-scout/raw/main/docs/preview.png"
  },
  "bundledDependencies": [
    "@earendil-works/pi-ai",
    "@earendil-works/pi-tui",
    "@earendil-works/pi-agent-core",
    "typebox"
  ]
}